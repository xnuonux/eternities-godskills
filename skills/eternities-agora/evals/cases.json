  "cases": [
    {"id":"direct-rapid-screen","kind":"direct","critical":true,"prompt":"Rapidly screen this authorized prospect using observable signals, disclose blind spots, and identify the smallest next checks.","expected":"route:prospect-assessment:rapid-screen"},
    {"id":"direct-multidimensional","kind":"direct","critical":true,"prompt":"Assess this prospect across independent dimensions with declared weights, evidence coverage, partial-failure handling, and bounded opportunities.","expected":"route:prospect-assessment:multidimensional"},
    {"id":"direct-portfolio","kind":"direct","critical":true,"prompt":"Reconcile our prospect records into a portfolio pipeline while preserving duplicate, partial, unmatched, and uncertain states.","expected":"route:account-operations:portfolio-pipeline"},
    {"id":"direct-account","kind":"direct","critical":true,"prompt":"Build a dated evidence-backed history for this one client account and stop if identity remains ambiguous.","expected":"route:account-operations:client-account"},
    {"id":"direct-rollup","kind":"direct","critical":true,"prompt":"Produce an operational rollup that separates observed pipeline, commercial, capability, activity, and follow-up indicators from estimates.","expected":"route:account-operations:operational-rollup"},
    {"id":"direct-proposal","kind":"direct","critical":true,"prompt":"Turn these verified client findings into a service proposal using the approved service and pricing policy, with assumptions and checkpoints visible.","expected":"route:client-deliverables:service-proposal"},
    {"id":"direct-report","kind":"direct","critical":true,"prompt":"Construct a validated client report-data contract, preserve missing dimensions, delegate exact rendering, and verify the artifact.","expected":"route:client-deliverables:client-report"},

    {"id":"paraphrase-rapid-screen","kind":"paraphrase","critical":true,"prompt":"Give me the quickest honest read on this lead without pretending we researched what we did not see.","expected":"route:prospect-assessment:rapid-screen"},
    {"id":"paraphrase-multidimensional","kind":"paraphrase","critical":true,"prompt":"Build a deeper opportunity picture where every factor, weight, gap, and failed evidence source remains inspectable.","expected":"route:prospect-assessment:multidimensional"},
    {"id":"paraphrase-portfolio","kind":"paraphrase","critical":true,"prompt":"Make sense of the whole lead book without throwing away messy records or quietly merging people who may differ.","expected":"route:account-operations:portfolio-pipeline"},
    {"id":"paraphrase-account","kind":"paraphrase","critical":true,"prompt":"Tell the traceable story of this customer's history, current state, missing assessments, and next bounded action.","expected":"route:account-operations:client-account"},
    {"id":"paraphrase-rollup","kind":"paraphrase","critical":true,"prompt":"Show how the agency is moving while labeling what is measured, inferred, stale, or only a commercial heuristic.","expected":"route:account-operations:operational-rollup"},
    {"id":"paraphrase-proposal","kind":"paraphrase","critical":true,"prompt":"Shape the proven needs into clear service options without inventing prices, promises, or unsupported benefits.","expected":"route:client-deliverables:service-proposal"},
    {"id":"paraphrase-report","kind":"paraphrase","critical":true,"prompt":"Turn the reconciled assessment data into a client-ready report whose finished document can be checked against the source contract.","expected":"route:client-deliverables:client-report"},

    {"id":"context-prospect","kind":"paraphrase","critical":true,"prompt":"We have a possible customer, scattered authorized evidence, and limited time; choose the honest assessment depth and return confidence plus next checks.","expected":"route:prospect-assessment:rapid-screen"},
    {"id":"context-account","kind":"paraphrase","critical":true,"prompt":"Several files disagree about one customer's dates and status, so reconstruct only what the evidence supports and preserve the collision.","expected":"route:account-operations:client-account"},
    {"id":"context-deliverable","kind":"paraphrase","critical":true,"prompt":"The findings are approved but the client artifact is not; create a bounded evidence-linked offer with assumptions and delivery phases.","expected":"route:client-deliverables:service-proposal"},

    {"id":"exclude-lookup","kind":"exclusion","critical":true,"prompt":"Find the phone number in this one contact record.","expected":"skip"},
    {"id":"exclude-status","kind":"exclusion","critical":true,"prompt":"Change this local record from open to closed.","expected":"skip"},
    {"id":"exclude-copy","kind":"exclusion","critical":true,"prompt":"Change the proposal heading from Our Plan to Next Steps.","expected":"skip"},

    {"id":"conflict-research","kind":"conflict","critical":true,"prompt":"Before assessing the prospect, investigate the latest external market and official regulatory evidence.","expected":"defer:eternities-oracle"},
