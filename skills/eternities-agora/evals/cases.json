    {"id":"conflict-implementation","kind":"conflict","critical":true,"prompt":"Build the approved persistent CRM integration and dashboard across this repository with tests and review.","expected":"defer:eternities-forge"},
    {"id":"conflict-rendering","kind":"conflict","critical":true,"prompt":"The report-data contract is finished; now produce and visually verify the exact final document.","expected":"defer:document-rendering"},
