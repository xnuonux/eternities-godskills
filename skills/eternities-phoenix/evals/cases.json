{"schemaVersion":1,"name":"eternities-phoenix-bounded-routing-and-recovery","cases":[{"id":"direct-debug","kind":"direct","critical":true,"prompt":"Diagnose a supplied reproducible local failure and verify a focused fix.","expected":"route:diagnosis-and-reproduction"},{"id":"direct-incident","kind":"direct","critical":true,"prompt":"Classify impact and prepare a rollback-backed recovery plan from an incident timeline.","expected":"route:incident-triage-and-recovery"},{"id":"direct-observability","kind":"direct","critical":true,"prompt":"Analyze supplied logs, traces, metrics, workload, and baseline for a performance regression.","expected":"route:observability-and-performance"},{"id":"direct-specialist","kind":"direct","critical":true,"prompt":"Package evidence and route a database or security decision to an authorized specialist.","expected":"route:specialist-routing"},{"id":"para-debug","kind":"paraphrase","critical":true,"prompt":"Find the root cause of this repeatable test failure without changing production.","expected":"route:diagnosis-and-reproduction"},{"id":"para-recovery","kind":"paraphrase","critical":true,"prompt":"Work out how to restore service with a tested way back.","expected":"route:incident-triage-and-recovery"},{"id":"para-performance","kind":"paraphrase","critical":true,"prompt":"Explain why the supplied workload got slower using measured signals.","expected":"route:observability-and-performance"},{"id":"para-handoff","kind":"paraphrase","critical":true,"prompt":"Hand this authority-sensitive platform issue to the right owner with its evidence intact.","expected":"route:specialist-routing"},{"id":"exclude-format","kind":"exclusion","critical":true,"prompt":"Rename a local diagnostic report without changing its content.","expected":"skip"},{"id":"exclude-background","kind":"exclusion","critical":true,"prompt":"Keep monitoring the system after this answer and alert me later.","expected":"refuse:background-loop"},{"id":"exclude-no-repro","kind":"ex