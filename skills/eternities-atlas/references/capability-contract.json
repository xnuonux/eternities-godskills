{
  "schemaVersion": 1,
  "id": "godskill-eternities-atlas-v1",
  "name": "eternities-atlas",
  "category": "data-infrastructure",
  "intent": "Reconcile bounded data questions, structures, transformations, and synchronization designs into evidence-bearing local artifacts without performing external or production changes.",
  "successCondition": "One dominant route produces a reproducible local artifact with scope, provenance, uncertainty, checks, effects, and authority gaps explicit.",
  "inputs": ["authorized data or schema evidence and bounded intent", "dialect/provider, keys, time window, baseline, acceptance and rollback requirements when applicable"],
  "outputs": ["route-specific analysis, query, schema, reconciliation, migration, compatibility, or sync packet", "evidence ledger, assumptions, discrepancies, measured results, proposed effects, refusal or handoff"],
  "operations": ["select the smallest sufficient route", "inspect and label evidence", "produce local reviewable artifacts", "verify gates before readiness claims", "fail closed and terminate"],
  "effects": ["read", "write"],
  "externalMutation": false,
  "positiveTriggers": ["analyze a bounded dataset or experiment", "diagnose a query or plan", "reconcile schemas or records", "design a schema", "plan a compatible migration", "design or diagnose relational sync or streaming"],
  "negativeTriggers": ["run against production or an external system", "retrieve or use credentials", "perform destructive migration or deletion", "proceed without backup, reconciliation evidence, or authority"],
  "failureModes": ["scope, dialect, keys, baseline, backup, rollback, or owner missing", "evidence is stale, partial, incomparable, or unverified", "requested effect exceeds local read/write authority", "provider-specific execution is mistaken for portable capability"],
  "dependencies": ["eternities-oracle", "eternities-aegis", "eternities-architect", "eternities-forge", "verification-before-completion"],
