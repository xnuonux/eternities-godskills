{
  "$id": "urn:eternities:godskill:eternities-forge:input:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilityId": {
      "const": "eternities-forge"
    },
    "missionId": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "slots": {
      "additionalProperties": false,
      "properties": {
        "acceptance-risk-boundary": {
          "description": "acceptance evidence and risk boundary",
          "type": "object",
          "x-eternities-type": "eternities.acceptance-contract"
        },
        "repository-state": {
          "description": "repository and working-tree state",
          "type": "object",
          "x-eternities-type": "eternities.repository-state"
        },
        "settled-outcome": {
          "description": "settled outcome or approved design",
          "type": "object",
          "x-eternities-type": "eternities.mission-spec"
        }
      },
      "required": [
        "settled-outcome",
        "repository-state",
        "acceptance-risk-boundary"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "capabilityId",
    "missionId",
    "slots"
  ],
  "title": "eternities-forge input envelope v1",
  "type": "object"
}
