    },
    {"id":"policy-lifecycle","capabilities":["policy-objective","control-owner","monitoring","exceptions","evidence","expiry"],"delegates":["eternities-oracle"]},
    {"id":"identity-access","capabilities":["principals","authenticators","lifecycle","federation","least-privilege","separation-of-duties"],"delegates":["eternities-oracle"]},
    {"id":"security-assurance","capabilities":["controls","detections","evidence-handling","risk-communication","residual-risk"],"delegates":["verification-before-completion"]}
    ,{"id":"skill-supply-chain","capabilities":["inert-static-scan","purpose-fit","permission-fit","exact-body-digests","semantic-review","promotion-gate"],"delegates":["verification-before-completion"]}
