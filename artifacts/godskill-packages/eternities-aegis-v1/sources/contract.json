{
  "schemaVersion": 1,
  "id": "godskill-eternities-aegis-v4",
  "name": "eternities-aegis",
  "category": "governance-security",
  "intent": "Reconcile authorization, system evidence, trust boundaries, and threat hypotheses into a defensible risk and mitigation decision.",
  "successCondition": "Verified findings are separated from hypotheses, risks are ranked by exploitability and impact, mitigations have proof and rollback, and no action exceeds the established authority.",
  "inputs": [
    "authorized target and effect boundary",
    "system or configuration evidence",
    "assets, identities, and trust relationships"
  ],
  "outputs": [
    "authorization statement",
    "asset and trust-boundary map",
    "evidence-ranked findings",
    "verified mitigation plan",
    "residual risk and authority ledger"
  ],
  "operations": [
    "establish authorization",
    "inspect security-relevant evidence",
    "model abuse and failure paths",
    "rank risk and confidence",
    "design and verify mitigations",
    "govern policy lifecycle evidence",
    "govern identity and access lifecycle",
    "assure defensive controls and evidence",
    "reconcile inert skill supply-chain evidence"
    ,"audit agentic CI source-to-sink paths"
  ],
  "effects": ["read", "write"],
  "positiveTriggers": [
    "authorized source and architecture security audit",
    "threat model a consequential system",
    "audit MCP or agent permissions and trust",
    "review authority for an external action"
    ,"audit attacker-controlled input reaching an AI action in CI"
    ,"review an acquired agent skill before indexing or promotion"
  ],
  "negativeTriggers": [
    "ordinary code review",
    "generic security checklist",
    "simple security fact",
    "unauthorized intrusion or adversary emulation",
    "credentialed or high-stakes assessment",
    "legal or current-policy conclusion"
  ],
  "failureModes": [
    "authorization is absent or ambiguous",
    "target evidence is unavailable",
    "a finding cannot be separated from hypothesis",
    "mitigation validation would exceed authority",
    "critical residual risk has no accountable owner",
    "credentials or unnecessary personal data would enter evidence",
    "provider behavior or current policy is assumed without evidence"
  ],
  "dependencies": [
    "eternities-oracle",
    "verification-before-completion",
    "installed exact security skills"
  ],
  "sourceIds": [
    "skill-72cad70c3765e1c2",
    "skill-6a5af032f4ae778f",
    "skill-81bf77b4de7d5da3",
    "skill-e2c045990c37a6b5"
  ],
  "explicitOnly": false,
  "routes": [
