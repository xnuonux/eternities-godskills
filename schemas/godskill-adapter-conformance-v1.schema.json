{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eternities.invalid/schemas/godskill-adapter-conformance-v1.schema.json",
  "title": "Eternities provider-neutral adapter conformance v1",
  "description": "Closed host projections and semantic equivalence fixture. This schema authorizes no execution or host adoption.",
  "$ref": "#/$defs/fixture",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "hostFamily": {
      "type": "string",
      "enum": ["claude-code", "codex", "godagents", "local-model", "mcp"]
    },
    "effect": {
      "type": "string",
      "enum": ["execute", "external-write", "network", "read", "write"]
    },
    "variantReason": {
      "type": "string",
      "enum": ["protocol-equivalent", "effect-narrowed", "package-protocol-unsupported", "protocol-version-unsupported", "secrets-not-isolated"]
    },
    "hostProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostFamily": { "$ref": "#/$defs/hostFamily" },
        "hostVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "modelFamily": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reasoningTier": { "type": "string", "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] },
        "contextBudget": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "reviewAvailable": { "type": "boolean" },
        "availableEffects": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/effect" } },
        "supportsPackageProtocol": { "type": "boolean" },
        "supportsProtocolVersion": { "type": "integer", "minimum": 0, "maximum": 32 },
        "secretsOutsidePayload": { "type": "boolean" }
      },
      "required": ["hostFamily", "hostVersion", "modelFamily", "reasoningTier", "contextBudget", "reviewAvailable", "availableEffects", "supportsPackageProtocol", "supportsProtocolVersion", "secretsOutsidePayload"]
    },
    "semanticDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missionId": { "$ref": "#/$defs/identifier" },
        "objectiveDigest": { "$ref": "#/$defs/digest" },
        "packageReceiptDigest": { "$ref": "#/$defs/digest" },
        "packageDigest": { "$ref": "#/$defs/digest" },
        "capabilityId": { "$ref": "#/$defs/identifier" },
        "capabilityVersion": { "type": "integer", "minimum": 1 },
        "requestedEffects": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/effect" } },
        "grantedEffects": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/effect" } },
        "activationMode": { "const": "guardrail" },
        "disclosureLayer": { "const": "guardrails" },
        "rawContentStored": { "const": false }
      },
      "required": ["missionId", "objectiveDigest", "packageReceiptDigest", "packageDigest", "capabilityId", "capabilityVersion", "requestedEffects", "grantedEffects", "activationMode", "disclosureLayer", "rawContentStored"]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "conformanceId": { "const": "eternities-godskill-adapter-conformance-v1" },
        "hostFamily": { "$ref": "#/$defs/hostFamily" },
        "status": { "type": "string", "enum": ["conformant", "unsupported"] },
        "reasonCodes": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/variantReason" } },
        "hostProfile": { "$ref": "#/$defs/hostProfile" },
        "decision": { "anyOf": [{ "$ref": "#/$defs/semanticDecision" }, { "type": "null" }] },
        "normalizedDecisionDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["schemaVersion", "conformanceId", "hostFamily", "status", "reasonCodes", "hostProfile", "decision", "normalizedDecisionDigest", "digest"]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "conformanceId": { "const": "eternities-godskill-adapter-conformance-v1" },
        "fixtureId": { "$ref": "#/$defs/identifier" },
        "protocolReceiptDigest": { "$ref": "#/$defs/digest" },
        "packageReceiptDigest": { "$ref": "#/$defs/digest" },
        "packageDigest": { "$ref": "#/$defs/digest" },
        "capabilityId": { "$ref": "#/$defs/identifier" },
        "capabilityVersion": { "type": "integer", "minimum": 1 },
        "missionId": { "$ref": "#/$defs/identifier" },
        "objectiveDigest": { "$ref": "#/$defs/digest" },
        "requestedEffects": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/effect" } },
        "hostFamilies": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/hostFamily" } },
        "projections": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/projection" } },
        "semanticDecision": { "$ref": "#/$defs/semanticDecision" },
        "normalizedDecisionDigest": { "$ref": "#/$defs/digest" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["schemaVersion", "conformanceId", "fixtureId", "protocolReceiptDigest", "packageReceiptDigest", "packageDigest", "capabilityId", "capabilityVersion", "missionId", "objectiveDigest", "requestedEffects", "hostFamilies", "projections", "semanticDecision", "normalizedDecisionDigest", "digest"]
    }
  }
}
