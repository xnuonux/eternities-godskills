{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eternities.ai/schemas/godskills/adaptive-activation-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolId",
    "requestId",
    "trustRootDigest",
    "classification",
    "selected",
    "authorityProjection"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "eternities-godskills-activation-v1" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000\\r\\n]+$" },
    "trustRootDigest": { "$ref": "#/$defs/digest" },
    "classification": { "$ref": "#/$defs/classification" },
    "selected": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/selection" }
    },
    "authorityProjection": { "$ref": "#/$defs/authorityProjection" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskClass", "consequenceClass", "reviewAvailable"],
      "properties": {
        "taskClass": { "enum": ["creative-generation", "debugging-recovery", "implementation", "research", "continuity", "verification", "general"] },
        "consequenceClass": { "enum": ["low", "consequential", "critical"] },
        "reviewAvailable": { "type": "boolean" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedId", "explicitMethodRequest"],
      "properties": {
        "selectedId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "explicitMethodRequest": { "type": "boolean" }
      }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "authorityProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availableAuthority", "permittedEffects", "availablePreconditions", "maximumRisk", "minimumEvidenceConfidence", "contextBudget"],
      "properties": {
        "availableAuthority": { "$ref": "#/$defs/stringSet" },
        "permittedEffects": { "$ref": "#/$defs/stringSet" },
        "availablePreconditions": { "$ref": "#/$defs/stringSet" },
        "maximumRisk": { "enum": ["low", "moderate", "high"] },
        "minimumEvidenceConfidence": { "enum": ["unverified", "inferred", "verified"] },
        "contextBudget": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
