{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactBytes": {
      "minimum": 0,
      "type": "integer"
    },
    "artifactDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "authorityExpanded": {
      "const": false
    },
    "caseResults": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "reasonCode": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "id",
                "passed",
                "reasonCode"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "critical": {
            "type": "boolean"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "matchedArtifactId": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "minLength": 1,
                "type": "string"
              }
            ]
          },
          "maximumScore": {
            "minimum": 0,
            "type": "number"
          },
          "score": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "matchedArtifactId",
          "critical",
          "score",
          "maximumScore",
          "checks"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "comparison": {
      "additionalProperties": false,
      "properties": {
        "baselineArtifactDigest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          ]
        },
        "baselineResultDigest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          ]
        },
        "counts": {
          "additionalProperties": false,
          "properties": {
            "losses": {
              "minimum": 0,
              "type": "integer"
            },
            "matched": {
              "minimum": 0,
              "type": "integer"
            },
            "ties": {
              "minimum": 0,
              "type": "integer"
            },
            "wins": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "matched",
            "wins",
            "losses",
            "ties"
          ],
          "type": "object"
        },
        "outcomeAgainstRaw": {
          "enum": [
            "baseline",
            "win",
            "loss",
            "tie"
          ]
        }
      },
      "required": [
        "baselineArtifactDigest",
        "baselineResultDigest",
        "outcomeAgainstRaw",
        "counts"
      ],
      "type": "object"
    },
    "criticalRegression": {
      "type": "boolean"
    },
    "detectedCases": {
      "minimum": 0,
      "type": "integer"
    },
    "evaluatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "evaluatorId": {
      "minLength": 1,
      "type": "string"
    },
    "evaluatorKind": {
      "enum": [
        "deterministic-verifier",
        "reviewer"
      ]
    },
    "maximumScore": {
      "minimum": 0,
      "type": "number"
    },
    "normalizationDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "oracleDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "packageId": {
      "minLength": 1,
      "type": "string"
    },
    "packageReceiptDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "parent": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifactDigest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "resultDigest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "variant": {
              "enum": [
                "raw",
                "guardrail",
                "method",
                "reviewer",
                "combined"
              ]
            }
          },
          "required": [
            "variant",
            "artifactDigest",
            "resultDigest"
          ],
          "type": "object"
        }
      ]
    },
    "reasonCodes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "resultDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schemaValid": {
      "type": "boolean"
    },
    "schemaVersion": {
      "const": 1
    },
    "score": {
      "minimum": 0,
      "type": "number"
    },
    "taskClass": {
      "enum": [
        "continuity",
        "creative-generation",
        "debugging-recovery",
        "general",
        "implementation",
        "research",
        "security-review",
        "verification"
      ]
    },
    "taskDefinitionDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "taskSourceDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "unsupportedFindings": {
      "minimum": 0,
      "type": "integer"
    },
    "variant": {
      "enum": [
        "raw",
        "guardrail",
        "method",
        "reviewer",
        "combined"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "packageId",
    "packageReceiptDigest",
    "evaluatorId",
    "evaluatorKind",
    "taskClass",
    "variant",
    "taskDefinitionDigest",
    "taskSourceDigest",
    "oracleDigest",
    "normalizationDigest",
    "artifactDigest",
    "artifactBytes",
    "schemaValid",
    "score",
    "maximumScore",
    "detectedCases",
    "unsupportedFindings",
    "caseResults",
    "comparison",
    "parent",
    "criticalRegression",
    "reasonCodes",
    "authorityExpanded",
    "evaluatedAt",
    "resultDigest"
  ],
  "title": "Adaptive evaluator result v1",
  "type": "object"
}
