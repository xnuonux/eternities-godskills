{
  "$id": "urn:eternities:adaptive-evidence:v2:lifecycle-decision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "promote",
        "demote",
        "quarantine",
        "invalidate"
      ]
    },
    "actorId": {
      "minLength": 1,
      "type": "string"
    },
    "authorityExpanded": {
      "const": false
    },
    "authorityKeyId": {
      "minLength": 1,
      "type": "string"
    },
    "authorityTrustRootDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "authorizationDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "bindingsDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "decidedAt": {
      "minLength": 1,
      "type": "string"
    },
    "decisionDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "evidenceDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "nextMode": {
      "enum": [
        "native",
        "guardrail",
        "method",
        "review"
      ]
    },
    "priorMode": {
      "enum": [
        "native",
        "guardrail",
        "method",
        "review"
      ]
    },
    "profileDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "reasonCodes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": 2
    },
    "status": {
      "enum": [
        "applied",
        "rejected",
        "no-change"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "action",
    "status",
    "actorId",
    "authorityKeyId",
    "authorityTrustRootDigest",
    "authorizationDigest",
    "profileDigest",
    "bindingsDigest",
    "evidenceDigest",
    "priorMode",
    "nextMode",
    "decidedAt",
    "reasonCodes",
    "authorityExpanded",
    "decisionDigest"
  ],
  "title": "Adaptive evidence v2 lifecycle decision",
  "type": "object"
}
