{
  "schemaVersion": 1,
  "id": "eternities-portable-router-v1",
  "artifacts": {
    "cards": "artifacts/routing/cards.jsonl",
    "familyMap": "artifacts/routing/family-map.json",
    "manifest": "artifacts/routing/manifest.json"
  },
  "doctrine": "runtime/agent-router.md",
  "maximumShortlist": 32,
  "maximumComposition": 3,
  "obligations": [
    "emit-route-receipt",
    "interpret-natural-language",
    "load-selected-only",
    "preserve-authority",
    "preserve-effects",
    "surface-unresolved-decisions"
  ]
}
